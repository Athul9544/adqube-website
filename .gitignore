# Vercel project link and the Blob read/write token it pulls down.
# Never commit these: the token grants write access to the live media store.
.vercel
.env*

# Installed, not authored.
node_modules

# Build output — produced from src/ and public/ by `npm run build`.
dist

# Original camera/export masters kept beside the project for re-encoding.
# They are large and nothing in the build reads them.
media-src

# Stray screenshots from local testing.
shot-*.png
